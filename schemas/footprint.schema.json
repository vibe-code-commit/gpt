{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/footprint.schema.json",
  "title": "NASDAQ Options Footprint",
  "type": "object",
  "required": [
    "ticker",
    "underlier",
    "strike",
    "expiry",
    "option_type",
    "tf",
    "start_ts",
    "end_ts",
    "confirmed_at",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "atr",
    "direction",
    "sequence_high",
    "sequence_low",
    "displacement_ratio",
    "sweep_side",
    "state",
    "state_updated_at",
    "ob_price",
    "next_swing_price",
    "liquidity_pool_id",
    "mss_tf",
    "hud_row"
  ],
  "properties": {
    "ticker": { "type": "string" },
    "underlier": { "type": "string" },
    "strike": { "type": "number" },
    "expiry": { "type": "string", "format": "date" },
    "option_type": { "type": "string", "enum": ["call", "put"] },
    "tf": { "type": "string", "enum": ["5m", "15m", "1h", "2h"] },
    "start_ts": { "type": "string", "format": "date-time" },
    "end_ts": { "type": "string", "format": "date-time" },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "open": { "type": "number" },
    "high": { "type": "number" },
    "low": { "type": "number" },
    "close": { "type": "number" },
    "volume": { "type": "number" },
    "atr": { "type": "number" },
    "direction": { "type": "string", "enum": ["bullish", "bearish"] },
    "sequence_high": { "type": "number" },
    "sequence_low": { "type": "number" },
    "displacement_ratio": { "type": "number", "minimum": 0 },
    "sweep_side": { "type": "string", "enum": ["high", "low", "none"] },
    "state": { "type": "string", "enum": ["New", "Unmitigated", "Touched", "Filled"] },
    "state_updated_at": { "type": "string", "format": "date-time" },
    "ob_price": { "type": "number" },
    "next_swing_price": { "type": "number" },
    "liquidity_pool_id": { "type": "string" },
    "mss_tf": { "type": "string", "enum": ["15m", "1h", "2h", "4h", "1d"] },
    "hud_row": { "type": "string" }
  },
  "additionalProperties": false
}
